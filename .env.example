NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
PROPOSAL_LINK_SECRET=
TRANSFORMATION_WORKER_SECRET=
TRANSFORMATION_WORKER_DRY_RUN=true
FOLLOW_UP_CRON_SECRET=
OPERATIONS_CRON_SECRET=
OPERATIONS_DRY_RUN=true
ACQUISITION_CRON_SECRET=
ACQUISITION_DRY_RUN=true
UNSUBSCRIBE_SECRET=
CALCOM_WEBHOOK_SECRET=
CALCOM_BOOKING_URL=https://cal.com/binahub/konsultasi
ALLOW_MOCK_PROPOSAL_SEND=false
FOLLOW_UP_TIME_ZONE=Asia/Jakarta
FOLLOW_UP_WINDOW_START=8
FOLLOW_UP_WINDOW_END=17
FOLLOW_UP_WEEKDAYS=1,2,3,4,5
# Comma-separated local dates, for example 2026-08-17,2026-12-25
FOLLOW_UP_HOLIDAYS=
FOLLOW_UP_ENFORCE_BUSINESS_WINDOW=true
# true untuk UAT/lokal: hanya menampilkan kandidat tanpa generate atau mengirim email
FOLLOW_UP_DRY_RUN=true
# Default true. Set false only for controlled development fallback; production
# follow-up must use a non-mock template approved in the admin dashboard.
FOLLOW_UP_REQUIRE_APPROVED_TEMPLATE=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=arcee-ai/trinity-large-thinking:free
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_COMPANY_COPY=admin@binahub.id
NEXT_PUBLIC_APP_URL=https://app-binahub.vercel.app
NEXT_PUBLIC_BINAHUB_API_URL=https://api.binahub.id
NEXT_PUBLIC_COMPANY_NAME=BinaHub
NEXT_PUBLIC_COMPANY_EMAIL=info@binahub.id

# Optional, explicit bootstrap fallback. Leave blank unless the account is controlled
# and reserved. Prefer the authoritative role in public.profiles.
ADMIN_EMAILS=
FACILITATOR_EMAILS=
