NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
PROPOSAL_LINK_SECRET=
# Phase 20.2: HMAC secret for opaque manual-outbound UAT links. Never expose
# it to the browser, Apollo, or templates. Generate a unique 32+ character value.
ACQUISITION_LINK_SECRET=
PUBLIC_WEBSITE_URL=https://binahub.id
# Master circuit breakers. Keep both false until a scheduled, accepted pilot
# change window is active. Live requires both switches to be true.
AUTOMATION_PILOT_ENABLED=false
AUTOMATION_LIVE_ENABLED=false
TRANSFORMATION_WORKER_SECRET=
TRANSFORMATION_WORKER_DRY_RUN=true
FOLLOW_UP_CRON_SECRET=
OPERATIONS_CRON_SECRET=
OPERATIONS_DRY_RUN=true
ACQUISITION_CRON_SECRET=
ACQUISITION_DRY_RUN=true
# Phase 18 AI Lead Agent. Every switch is fail-closed by default.
LEAD_AGENT_SECRET=
LEAD_AGENT_PROVIDER=apollo
LEAD_AGENT_ENABLED=false
LEAD_AGENT_PROVIDER_CALLS_ENABLED=false
LEAD_AGENT_DRY_RUN=true
LEAD_AGENT_STAGING_ENABLED=false
LEAD_AGENT_AI_SCORING_ENABLED=false
LEAD_AGENT_SOURCE_ID=
LEAD_AGENT_SOURCE_KEY=ai_lead_discovery_apollo
LEAD_AGENT_CAMPAIGN_ID=
LEAD_AGENT_CAMPAIGN_CODE=AI_LEAD_DISCOVERY_APOLLO
LEAD_AGENT_MAX_CANDIDATES_PER_RUN=10
LEAD_AGENT_MAX_CANDIDATES_PER_DAY=25
LEAD_AGENT_MIN_SCORE=50
LEAD_AGENT_REQUEST_TIMEOUT_MS=20000
LEAD_AGENT_APOLLO_ENRICH_WORK_EMAILS=false
APOLLO_API_KEY=
# Hunter is an optional inactive adapter. Leave its credentials and switches
# empty/false while the current workflow uses Apollo manual CSV imports.
LEAD_AGENT_HUNTER_ENRICH_WORK_EMAILS=false
LEAD_AGENT_HUNTER_AI_QUERY_ENABLED=false
LEAD_AGENT_HUNTER_MAX_DOMAIN_SEARCHES_PER_RUN=3
HUNTER_API_KEY=
PILOT_MONITOR_SECRET=
# true: snapshot tercatat, finding tidak dibuat menjadi incident otomatis
PILOT_MONITOR_DRY_RUN=true
UNSUBSCRIBE_SECRET=
CALCOM_WEBHOOK_SECRET=
CALCOM_BOOKING_URL=https://cal.com/binahub/konsultasi
ALLOW_MOCK_PROPOSAL_SEND=false
FOLLOW_UP_TIME_ZONE=Asia/Jakarta
FOLLOW_UP_WINDOW_START=8
FOLLOW_UP_WINDOW_END=17
FOLLOW_UP_WEEKDAYS=1,2,3,4,5
# Comma-separated local dates, for example 2026-08-17,2026-12-25
FOLLOW_UP_HOLIDAYS=
FOLLOW_UP_ENFORCE_BUSINESS_WINDOW=true
# true untuk UAT/lokal: hanya menampilkan kandidat tanpa generate atau mengirim email
FOLLOW_UP_DRY_RUN=true
# Default true. Set false only for controlled development fallback; production
# follow-up must use a non-mock template approved in the admin dashboard.
FOLLOW_UP_REQUIRE_APPROVED_TEMPLATE=true
# Primary AI provider. Keep credentials in the deployment secret store only.
CODECRAFT_API_KEY=
CODECRAFT_BASE_URL=https://codecraftapi.com/v1
CODECRAFT_MODEL=claude-sonnet-5
CODECRAFT_FALLBACK_MODELS=gpt-5.6-sol,claude-opus-5,qwen3.8-max
CODECRAFT_REASONING_MODEL=claude-opus-5
CODECRAFT_VISION_MODEL=claude-opus-5
AI_REASONING_ENABLED=true
AI_JSON_MODE_ENABLED=false
AI_MAX_TOKENS=8192
AI_REQUEST_TIMEOUT_MS=45000
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REASONING_MODEL=
OPENROUTER_VISION_MODEL=
# Final provider fallback after all CodeCraft attempts fail.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=arcee-ai/trinity-large-thinking:free
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_COMPANY_COPY=admin@binahub.id
NEXT_PUBLIC_APP_URL=https://app-binahub.vercel.app
NEXT_PUBLIC_BINAHUB_API_URL=https://api.binahub.id
NEXT_PUBLIC_COMPANY_NAME=BinaHub
NEXT_PUBLIC_COMPANY_EMAIL=info@binahub.id

# Optional, explicit bootstrap fallback. Leave blank unless the account is controlled
# and reserved. Prefer the authoritative role in public.profiles.
ADMIN_EMAILS=
FACILITATOR_EMAILS=

# Read-only production hardening smoke. Supply the admin password only in the
# invoking process; never save it in a committed env file.
PHASE19_API_URL=https://api.binahub.id
PHASE19_ADMIN_EMAIL=admin@binahub.id
PHASE19_ADMIN_PASSWORD=
PHASE19_EXPECT_LOCKED=true
